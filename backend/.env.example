# ============================================================
# Backend environment file. Copy to backend/.env for local dev.
# Loaded by app/core/config.py via pydantic-settings.
# ============================================================

# --- App ---
ENVIRONMENT=development
DEBUG=true

# --- Database (used from Task 3 onward) ---
# When the backend runs on the host and MySQL runs in docker-compose:
DATABASE_URL=mysql+pymysql://career:change-me@localhost:3306/career_assistant

# --- JWT (used from Task 5 onward) ---
# Use at least 32 characters. Generate one:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Gemini ---
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MAX_RETRIES=2

# --- CORS ---
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
