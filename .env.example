# ============================================================
# Root environment file for docker-compose.
# Copy to .env and adjust values. Never commit the real .env.
# ============================================================

# ---- MySQL container ----
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=career_assistant
MYSQL_USER=career
MYSQL_PASSWORD=change-me
MYSQL_PORT=3306

# ---- Backend container ----
# Full SQLAlchemy URL used by the FastAPI app.
# Host is the compose service name "mysql" when running via docker-compose.
DATABASE_URL=mysql+pymysql://career:change-me@mysql:3306/career_assistant
BACKEND_PORT=8000

# JWT
JWT_SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash

# CORS (comma-separated origins the browser app is served from)
CORS_ORIGINS=http://localhost:5173

# ---- Frontend container ----
FRONTEND_PORT=5173
# Base URL the browser uses to reach the backend API.
VITE_API_BASE_URL=http://localhost:8000
