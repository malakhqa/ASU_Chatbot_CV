# ============================================================
# Root environment file for docker-compose.
# Copy to .env and adjust values. Never commit the real .env.
# ============================================================

# ---- MySQL container ----
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=career_assistant
MYSQL_USER=career
MYSQL_PASSWORD=change-me
# Only used by docker-compose.override.yml to publish MySQL on 127.0.0.1
# for local tooling (Workbench). The base compose file never publishes it.
MYSQL_PORT=3306

# ---- Backend container ----
# Full SQLAlchemy URL used by the FastAPI app. Inside docker-compose the host
# is the service name "mysql". (For a backend run on the host instead, use
# backend/.env with @localhost:3306.)
DATABASE_URL=mysql+pymysql://career:change-me@mysql:3306/career_assistant
BACKEND_PORT=8000

# development | production. "production" makes the app refuse to start unless
# JWT_SECRET_KEY and DATABASE_URL are set to real values.
ENVIRONMENT=development
DEBUG=false

# JWT — generate one: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Gemini — leave EMPTY until you have a real key (non-empty = "configured" → 502s)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# CORS — origins the browser app is served from. Not hit in the default
# docker-compose setup (the frontend calls /api on its own origin), but used
# if you point VITE_API_BASE_URL straight at the backend.
CORS_ORIGINS=http://localhost:5173

# ---- Frontend container ----
FRONTEND_PORT=5173
# Base URL the browser uses to reach the API. Leave EMPTY for docker-compose:
# the frontend nginx proxies /api to the backend, so same-origin calls work
# with no CORS. Set it (e.g. http://localhost:8000) only to bypass that proxy.
VITE_API_BASE_URL=
